{
  "name": "sandbox-broker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --sequential typecheck",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "openapi:generate": "tsx packages/contracts/scripts/generate-openapi.ts",
    "openapi:check": "tsx packages/contracts/scripts/generate-openapi.ts --check",
    "docker:build": "bash scripts/docker-build.sh",
    "release:pack": "bash scripts/pack-release.sh",
    "release:pack:verify": "bash scripts/pack-release.sh --verify",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test && pnpm openapi:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.4"
  }
}
